{
  "name": "filmsbyrandy-agreements",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private client agreement pages for filmsbyrandy.com (Cloudflare Worker + D1 + Resend)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute filmsbyrandy-agreements --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute filmsbyrandy-agreements --local --file=schema.sql",
    "new-client": "node scripts/new-client.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "wrangler": "^4.162.0"
  }
}
